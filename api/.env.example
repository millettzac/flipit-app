# FlipIt API Configuration

# Node Environment
NODE_ENV=development
PORT=5000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# Platform API Keys (obtained during platform OAuth setup)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Upload Storage (optional - for image hosting)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email Service (optional - for notifications)
SENDGRID_API_KEY=

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*
